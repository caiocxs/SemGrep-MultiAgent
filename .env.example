# Copy to .env (the setup scripts do it automatically) and adjust per machine.
# Paths use "/" on every OS - Python's pathlib handles it on Windows too.

# Models used by `python -m src` (the detector benchmark). Files live in .models/.
# Model assignments per pipeline role live in configs/combos/, not here.
QWEN_CODE='Qwen2.5-Coder-3B-Q4_K_M.gguf'
DEEP_SEEK_CODER='deepseek-coder-1.3b-instruct.Q4_K_M.gguf'
STARCODER2='starcoder2-3b-instruct-techxgenus.Q4_K_M.gguf'

# Datasets
CWE_401='datasets/401/'
CWE_415='datasets/415/'
CWE_416='datasets/416/'
CWE_457='datasets/457/'
CWE_476='datasets/476/'

CWES_BAD='datasets/cwes_mixed/bad/'
CWES_GOOD='datasets/cwes_mixed/good/'

MIXED='datasets/bad_good/'

# Logs
LOGS_LOCATION='logs/dataset/'

# GPU
# Number of model layers to offload to the GPU. -1 offloads all layers, 0 keeps everything on CPU.
N_GPU_LAYERS=0

# Context window size (prompt + response combined). Must be bigger than
# max_tokens in code_agent.py plus the largest prompt, or llama_decode fails.
N_CTX=16384
